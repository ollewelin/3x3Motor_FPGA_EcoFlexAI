MIPI_INTEGRATION_GUIDE.md
QUICK_REFERENCE_CARD.md
QUICK_START_TEST_GUIDE.md
README_MIPI_ARCHITECTURE.md
UPDATED_IMPLEMENTATION_SUMMARY.md

# --- Old scratch C files at top level ---
lite_soc_a_LOOPBACK_test.c
lite_soc_a old copy LED and UART APB3 OK.c
12mA_ALL_TXC_delay_8_rest_delay_8.txt
8mA_TXC_12mA_TXCTL_4mA_TXD.txt
RGMII_drive_stringth_tests.txt

# --- Scratch text / test notes ---
diff*.html
*.lock
check_crc_errors.txt
command_olle_fdti_wrap.txt
golden_frame_receive.txt
magic_command_no_CRC.txt
NU.txt
several_test.txt
test3.txt
test5.txt
test_udp.txt
golden_frame
eth_crc32_b
Eth_seq

# --- Screenshots / images ---
*.png
*.jpg

# --- Debug / temp ---
*.log

# --- OS / editor ---
.DS_Store
*~
*.swp
.vscode/

# --- Exceptions: keep only a couple of embedded_sw files, unignore them ---
# We ignore the generated BSP/SoC files but explicitly allow these source files
# so they remain tracked and can be shared publicly.
!embedded_sw/SoC_mini_A/software/standalone/lite_soc_a/
!embedded_sw/SoC_mini_A/software/standalone/lite_soc_a/makefile
!embedded_sw/SoC_mini_A/software/standalone/lite_soc_a/src/
!embedded_sw/SoC_mini_A/software/standalone/lite_soc_a/src/lite_soc_a.c

# Allow the two MDIO driver headers you want to add
!embedded_sw/SoC_mini_A/software/standalone/driver/
!embedded_sw/SoC_mini_A/software/standalone/driver/mdio_driver_Ti60.h
!embedded_sw/SoC_mini_A/software/standalone/driver/mdio_driver.h

