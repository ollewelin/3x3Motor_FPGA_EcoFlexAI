# =============================================================================
# Efinity FPGA Project .gitignore
# =============================================================================

# --- Build outputs (regenerated by Efinity) ---
outflow/
work_syn/
work_pnr/
work_pt/
work_dbg/

# --- Debugging_setup (old snapshot, not part of active design) ---
Debugging_setup/

# --- T120 embedded SW (different board) ---
T120_embedded_sw/

# --- SoC IP (large, generated by Efinity IP Manager) ---
# Keep settings.json, main .v, defines — ignore generated devkit dirs & sims
ip/SoC_mini_A/Tz170J484_devkit/
ip/SoC_mini_A/Ti60F225_devkit/
ip/SoC_mini_A/T120F324_devkit/
ip/SoC_mini_A/Ti180J484_devkit/
ip/SoC_mini_A/Testbench/
ip/SoC_mini_A/ipm/
ip/SoC_mini_A/source/
ip/SoC_mini_A/*.bin

# --- MDIO simulation / backup / docs (keep only mdio_master.sv) ---
ip/mdio_master/sim/
ip/mdio_master/*.bak
ip/mdio_master/*.md
ip/mdio_master/*.txt
ip/mdio_master/*.sh
ip/mdio_master/tb_*.sv
ip/mdio_master/mdio_master_fixed.sv
ip/mdio_master/mdio_master_stage2.sv
ip/mdio_master/mdio_master_T120.sv
ip/mdio_master/mdio_master_Ti60.sv
ip/mdio_master/mdio_master_top.sv

# --- Embedded SW: keep ONLY your firmware src, ignore Efinity SDK examples ---
embedded_sw/SoC_mini_A/bsp/
embedded_sw/SoC_mini_A/.metadata/
embedded_sw/SoC_mini_A/tool/
embedded_sw/SoC_mini_A/software/freeRTOS/
embedded_sw/SoC_mini_A/software/standalone/apb3/
embedded_sw/SoC_mini_A/software/standalone/application/
embedded_sw/SoC_mini_A/software/standalone/axi4/
embedded_sw/SoC_mini_A/software/standalone/bootloader/
embedded_sw/SoC_mini_A/software/standalone/common/
embedded_sw/SoC_mini_A/software/standalone/customInstruction/
embedded_sw/SoC_mini_A/software/standalone/driver/
embedded_sw/SoC_mini_A/software/standalone/fpu/
embedded_sw/SoC_mini_A/software/standalone/gpio/
embedded_sw/SoC_mini_A/software/standalone/i2c/
embedded_sw/SoC_mini_A/software/standalone/smp/
embedded_sw/SoC_mini_A/software/standalone/spi/
embedded_sw/SoC_mini_A/software/standalone/timer/
embedded_sw/SoC_mini_A/software/standalone/uart/
embedded_sw/SoC_mini_A/software/standalone/userInterrupt/
embedded_sw/SoC_mini_A/software/standalone/vexriscv/

# --- Embedded build artifacts & Eclipse project files ---
**/*.o
**/*.elf
**/*.hex
**/*.map
**/*.lst
**/*.d
**/*.asm
**/*.bin
**/.cproject
**/.project
**/.settings/
**/co_debug/
**/*.launch

# --- Waveform / capture / simulation files ---
*.vcd
*.pcapng
*.gtkw
*.vvp

# --- Backup / scratch copies ---
*copy*.sv
*copy*.xml
*OLD*.sv
*OLD*.c
*original*.sv
eth_tx_1gbit_udp_OLD.sv
backup/

# --- Old/unused design files ---
T120_top_level.sv
T120_test_1g_udp.c
clk_test.vhd
golden_frame_gen_udp.sv

# --- Generated markdown docs (can be regenerated) ---
ANSWERS_TO_YOUR_QUESTIONS.md
ARCHITECTURE_CHANGE_SUMMARY.md
CHECKLIST.md
IMPLEMENTATION_COMPLETE.md
INTERFACE_DESIGN_CHOICES.md
MIPI_DIRECT_ARCHITECTURE.md
