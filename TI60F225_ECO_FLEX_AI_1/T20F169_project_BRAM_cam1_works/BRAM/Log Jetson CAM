sudo mount -t debugfs none /sys/kernel/debug 2>/dev/null || true
sudo sh -c 'echo 0 > /sys/kernel/debug/tracing/tracing_on'
sudo sh -c 'echo nop > /sys/kernel/debug/tracing/current_tracer'
sudo sh -c 'echo 0 > /sys/kernel/debug/tracing/events/enable'

sudo sh -c 'echo 1 > /sys/kernel/debug/tracing/events/i2c/i2c_write/enable'
sudo sh -c 'echo 1 > /sys/kernel/debug/tracing/events/i2c/i2c_read/enable'
sudo sh -c 'echo 1 > /sys/kernel/debug/tracing/events/i2c/i2c_reply/enable'
sudo sh -c 'echo 1 > /sys/kernel/debug/tracing/events/i2c/i2c_result/enable'

# filter (om fält finns)
sudo sh -c "cat /sys/kernel/debug/tracing/events/i2c/i2c_write/format"
sudo sh -c "echo 'adapter_nr==6 && addr==0x10' > /sys/kernel/debug/tracing/events/i2c/i2c_write/filter"
sudo sh -c "echo 'adapter_nr==6 && addr==0x10' > /sys/kernel/debug/tracing/events/i2c/i2c_read/filter"
sudo sh -c "echo 'adapter_nr==6 && addr==0x10' > /sys/kernel/debug/tracing/events/i2c/i2c_reply/filter"
sudo sh -c "echo 'adapter_nr==6' > /sys/kernel/debug/tracing/events/i2c/i2c_result/filter"

sudo sh -c 'echo 2048 > /sys/kernel/debug/tracing/buffer_size_kb'
sudo sh -c 'echo 1 > /sys/kernel/debug/tracing/tracing_on'
sudo cat /sys/kernel/debug/tracing/trace_pipe

